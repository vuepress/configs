{
  "name": "@vuepress/configs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "check-types": "tsc --noEmit --skipLibCheck",
    "clean": "pnpm -r run clean",
    "format": "oxfmt",
    "lint": "oxlint -c oxlint.config.ts && oxfmt --check",
    "prepare": "husky",
    "release": "pnpm release:check && pnpm release:version",
    "release:check": "pnpm clean && pnpm build && pnpm lint && pnpm check-types",
    "release:version": "lerna version"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@commitlint/types": "catalog:dev",
    "@lerna-lite/cli": "catalog:dev",
    "@lerna-lite/publish": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vuepress/oxfmt-config": "workspace:*",
    "@vuepress/oxlint-config": "workspace:*",
    "@vuepress/tsconfig": "workspace:*",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "oxfmt": "catalog:oxfmt",
    "oxlint": "catalog:oxlint",
    "oxlint-tsgolint": "catalog:oxlint",
    "rimraf": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "lint-staged": {
    "!(test)/**/*.(js|ts)": [
      "oxlint -c oxlint.config.ts --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(test)/**/*.!(js|ts)": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    }
  }
}
